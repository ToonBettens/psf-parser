"val0" FLOAT DOUBLE PROP(
"units" "V"
"description" "Zero value used in pulse and exponential waveforms"
)
"val1" FLOAT DOUBLE PROP(
"units" "V"
"description" "One value used in pulse and exponential waveforms"
)
"period" FLOAT DOUBLE PROP(
"units" "s"
"description" "Period of waveform. When type=prbs, period defines the bit duration"
)
"rise" FLOAT DOUBLE PROP(
"units" "s"
"description" "Rise time for pulse waveform (time for transition from `val0' to `val1'). If the rise parameter is not specified, the rise time is the same as fall time. If fall time is also not specified, the rise time is 1/100 of the waveform period. If the waveform is not periodic, the rise time is 1/100 of the simulation interval. The simulation interval is the minimum value of `width' and `stop-start-width', here start and stop are the transient start time and stop time. If type=prbs, the rise time is 1/10 of the bit duration"
)
"fall" FLOAT DOUBLE PROP(
"units" "s"
"description" "Fall time for pulse waveform (time for transition from `val1' to `val0'). If the fall parameter is not specified, the fall time is the same as rise time. If the rise time is also not specified, the fall time is 1/100 of the waveform period. If the waveform is not periodic, the fall time is 1/100 of the simulation interval. The simulation interval is the minimum value of `width' and `stop-start-width', here start and stop are the transient start time and stop time. if type=prbs, the fall time is 1/10 of the bit duration"
)
"width" FLOAT DOUBLE PROP(
"units" "s"
"description" "Pulse width (duration of `val1')"
)
"offset" FLOAT DOUBLE PROP(
"units" "V"
"description" "DC offset for the PWL waveform"
)
"scale" FLOAT DOUBLE PROP(
"description" "Scale factor for the PWL waveform"
)
"stretch" FLOAT DOUBLE PROP(
"description" "Scale factor for time given for the PWL waveform"
)
"rms" FLOAT DOUBLE PROP(
"description" "Desired rms (root of mean square) value of the PWL waveform"
)
"rolloff" FLOAT DOUBLE PROP(
"description" "Desired rolloff factor for the raised cosine filter. The default value is 0.2. This parameter is valid only when 'pwlfilter' is set to nrc"
)
"pwlbandwidth" FLOAT DOUBLE PROP(
"description" "Bandwidth of the pwl input signal. This parameter is used when 'pwlfilter' is set to nrc"
)
"pwlperiod" FLOAT DOUBLE PROP(
"units" "s"
"description" "Period of the periodic PWL waveform"
)
"pwlperiodstart" FLOAT DOUBLE PROP(
"units" "s"
"description" "Period start time of the periodic PWL waveform"
)
"pwlperiodstop" FLOAT DOUBLE PROP(
"units" "s"
"description" "Period stop time of the periodic PWL waveform"
)
"pwlperiodstopvalue" FLOAT DOUBLE PROP(
